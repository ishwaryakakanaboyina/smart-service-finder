# ============================================================================
# SMART SERVICE FINDER - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# JWT Secret for Session & API Token Signing (minimum 32 random characters in production)
JWT_SECRET=replace_with_a_secure_jwt_secret_token_key_here

# Administrative Portal Credentials
# Configurable via environment as required
ADMIN_EMAIL=iswaryakakanaboyina@gmail.com
ADMIN_PASSWORD=Admin@SecurePass2026!
ADMIN_NAME=kakanaboyina venkata siva lakshmi ishwarya

# Supabase / PostgreSQL Database Connection
# If left blank, the app uses built-in persistent storage for instant zero-dependency execution
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
USE_LOCAL_STORAGE=true

# AWS Deployment Placeholders (Do NOT commit real keys to source control)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
